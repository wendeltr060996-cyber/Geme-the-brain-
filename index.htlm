<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no">
<title>FISH WORLD — THE BRAIN GAME</title>
<style>
:root{--blue:#062b65;--cyan:#48eaff;--gold:#ffd34d}
*{box-sizing:border-box}
html,body{margin:0;width:100%;height:100%;overflow:hidden;background:#031b42;font-family:system-ui,Arial,sans-serif;color:#fff;touch-action:none}
#game{display:block;width:100vw;height:100vh;image-rendering:pixelated;background:#087fba}
#hud{position:fixed;top:10px;left:10px;right:10px;display:flex;justify-content:space-between;align-items:flex-start;pointer-events:none;gap:8px}
.panel{background:linear-gradient(180deg,#123e80ee,#061e50ee);border:3px solid #7ceaff;border-radius:13px;padding:8px 12px;box-shadow:0 4px 0 #031338,0 0 14px #32dfff66;font-weight:900;text-shadow:2px 2px #09204b}
#brand{position:fixed;top:10px;left:50%;transform:translateX(-50%);font-size:clamp(18px,4vw,32px);font-weight:1000;letter-spacing:1px;color:#ffe46c;text-shadow:3px 3px #9b3b05,-2px -2px #06336e,0 0 12px #35eaff;text-align:center;pointer-events:none;white-space:nowrap}
#brand small{display:block;font-size:10px;letter-spacing:3px;color:#fff}
#pause{pointer-events:auto;border:2px solid #9cf5ff;border-radius:10px;background:#0755a5;color:white;font-size:22px;font-weight:900;width:42px;height:42px}
#message{position:fixed;left:50%;top:22%;transform:translateX(-50%);background:#06285de8;border:2px solid #ffe16b;border-radius:12px;padding:10px 16px;font-weight:900;text-align:center;display:none;max-width:90vw}
#controls{position:fixed;bottom:16px;left:16px;right:16px;display:flex;justify-content:space-between;align-items:flex-end;pointer-events:none}
.pad{display:grid;grid-template-columns:48px 48px 48px;grid-template-rows:48px 48px 48px;gap:4px;pointer-events:auto}
.ctrl,.action{border:2px solid #8cecff;background:linear-gradient(#1688d9,#06417e);color:white;border-radius:12px;font-size:22px;font-weight:1000;box-shadow:0 4px 0 #03214a;touch-action:none}
.ctrl:active,.action:active{transform:translateY(3px);box-shadow:0 1px 0 #03214a}
.up{grid-column:2}.left{grid-column:1;grid-row:2}.down{grid-column:2;grid-row:2}.right{grid-column:3;grid-row:2}
.actions{display:flex;gap:10px;pointer-events:auto}.action{width:58px;height:58px;border-radius:50%;font-size:24px}
#help{position:fixed;bottom:10px;left:50%;transform:translateX(-50%);font-size:11px;color:#d8f8ff;text-shadow:1px 2px #00204b;white-space:nowrap;pointer-events:none}
@media(min-width:800px){.pad{opacity:.72}.action{opacity:.8}}
</style>
</head>
<body>
<canvas id="game"></canvas>
<div id="brand">🐠 FISH WORLD<small>THE BRAIN GAME</small></div>
<div id="hud">
  <div class="panel">VIDA <span id="lives">❤️❤️❤️</span><br><span style="color:#ffe46b">PONTOS:</span> <span id="score">000000</span></div>
  <div style="display:flex;gap:7px;align-items:flex-start"><div class="panel">🪙 <span id="coins">0</span></div><button id="pause">Ⅱ</button></div>
</div>
<div id="message"></div>
<div id="controls">
  <div class="pad">
    <button class="ctrl up" data-dir="up">▲</button>
    <button class="ctrl left" data-dir="left">◀</button>
    <button class="ctrl down" data-dir="down">▼</button>
    <button class="ctrl right" data-dir="right">▶</button>
  </div>
  <div class="actions"><button class="action" id="boost">⚡</button><button class="action" id="interact">🐟</button></div>
</div>
<div id="help">Use WASD / setas ou os controles para nadar • Explore e recolha moedas</div>
<script>
(() => {
'use strict';
const canvas=document.getElementById('game'),ctx=canvas.getContext('2d');
ctx.imageSmoothingEnabled=false;
let W=0,H=0,worldW=2600,worldH=1700,camera={x:0,y:0},paused=false;
let player={x:180,y:850,vx:0,vy:0,dir:1,boost:0,inv:0};
let score=Number(localStorage.getItem('fw_score')||0),coins=Number(localStorage.getItem('fw_coins')||0),lives=3;
let keys={},touch={},time=0,toastTimer=0;
const $=id=>document.getElementById(id);
function resize(){W=canvas.width=Math.floor(innerWidth*devicePixelRatio);H=canvas.height=Math.floor(innerHeight*devicePixelRatio);canvas.style.width=innerWidth+'px';canvas.style.height=innerHeight+'px';ctx.setTransform(devicePixelRatio,0,0,devicePixelRatio,0,0);W=innerWidth;H=innerHeight;}
addEventListener('resize',resize);resize();
const rand=(a,b)=>a+Math.random()*(b-a);
const bubbles=Array.from({length:95},()=>({x:rand(0,worldW),y:rand(0,worldH),r:rand(2,7),s:rand(.35,1.5),w:rand(0,6.28)}));
const fish=Array.from({length:42},(_,i)=>({x:rand(40,worldW-40),y:rand(100,worldH-100),s:rand(.45,1.4),dir:Math.random()<.5?-1:1,c:['#ffad28','#43d9ff','#ffe45a','#f47aff','#7cf0a4'][i%5],phase:rand(0,6.28),kind:i%5}));
const kelp=Array.from({length:65},()=>({x:rand(0,worldW),y:rand(200,worldH),h:rand(35,105),phase:rand(0,6.28),c:['#168c58','#20b76b','#087c69'][Math.floor(rand(0,3))]}));
const treasures=Array.from({length:35},()=>({x:rand(100,worldW-100),y:rand(180,worldH-100),got:false,phase:rand(0,6.28)}));
const zones=[
 {x:0,y:0,w:650,h:worldH,name:'1 • OCEANO AZUL',color:'#168bc4'},
 {x:650,y:0,w:650,h:worldH,name:'2 • FLORESTA DE ALGAS',color:'#087e86'},
 {x:1300,y:0,w:650,h:worldH,name:'3 • CAVERNAS SUBMARINAS',color:'#263d91'},
 {x:1950,y:0,w:650,h:worldH,name:'4 • CIDADE SUBMERSA',color:'#1671a3'}
];
function rounded(x,y,w,h,r,fill,stroke){ctx.beginPath();ctx.roundRect(x,y,w,h,r);ctx.fillStyle=fill;ctx.fill();if(stroke){ctx.strokeStyle=stroke;ctx.lineWidth=3;ctx.stroke();}}
function text(t,x,y,size=18,color='white'){ctx.font=`900 ${size}px system-ui`;ctx.textAlign='center';ctx.lineWidth=4;ctx.strokeStyle='#06234e';ctx.strokeText(t,x,y);ctx.fillStyle=color;ctx.fillText(t,x,y);}
function drawFish(x,y,s,dir,c,phase=0){ctx.save();ctx.translate(x,y+Math.sin(time*3+phase)*3);ctx.scale(dir*s,s);ctx.fillStyle=c;ctx.strokeStyle='#09264d';ctx.lineWidth=2;ctx.beginPath();ctx.moveTo(-13,0);ctx.lineTo(-23,-9+Math.sin(time*10+phase)*3);ctx.lineTo(-23,9+Math.sin(time*10+phase)*3);ctx.closePath();ctx.fill();ctx.stroke();ctx.beginPath();ctx.ellipse(0,0,15,10,0,0,Math.PI*2);ctx.fill();ctx.stroke();ctx.fillStyle='#fff';ctx.beginPath();ctx.arc(7,-3,4,0,Math.PI*2);ctx.fill();ctx.fillStyle='#071c3a';ctx.beginPath();ctx.arc(8,-3,2,0,Math.PI*2);ctx.fill();ctx.restore();}
function drawCoral(x,y,scale=1){ctx.save();ctx.translate(x,y);ctx.scale(scale,scale);ctx.lineCap='round';for(let i=0;i<5;i++){ctx.strokeStyle=['#ff5b8b','#ff9d36','#c45bff','#ff4f50'][i%4];ctx.lineWidth=7;ctx.beginPath();ctx.moveTo(0,0);ctx.quadraticCurveTo((i-2)*8,-18,(i-2)*13,-35-rand(0,3));ctx.stroke();}ctx.restore();}
function drawScene(){
 const grad=ctx.createLinearGradient(0,0,0,H);grad.addColorStop(0,'#087fbd');grad.addColorStop(.55,'#07558c');grad.addColorStop(1,'#032b5d');ctx.fillStyle=grad;ctx.fillRect(0,0,W,H);
 ctx.save();ctx.translate(-camera.x,-camera.y);
 // soft light rays
 for(let i=0;i<9;i++){let x=i*330+80+Math.sin(time*.35+i)*28;ctx.fillStyle='rgba(145,239,255,.055)';ctx.beginPath();ctx.moveTo(x,0);ctx.lineTo(x+85,0);ctx.lineTo(x+260,worldH);ctx.lineTo(x+70,worldH);ctx.fill();}
 // seabed
 ctx.fillStyle='#b28a48';ctx.fillRect(0,worldH-125,worldW,125);ctx.fillStyle='#e4c16b';for(let i=0;i<100;i++){ctx.fillRect(i*27,worldH-120+Math.sin(i)*7,18,5);}
 // zone landmarks and labels
 zones.forEach((z,i)=>{ctx.fillStyle=i%2?'rgba(5,36,83,.10)':'rgba(77,217,240,.06)';ctx.fillRect(z.x,0,z.w,worldH);text(z.name,z.x+z.w/2,75,22,'#fff0a2');});
 // shipwreck
 ctx.save();ctx.translate(280,worldH-370);ctx.rotate(-.12);ctx.fillStyle='#684022';ctx.strokeStyle='#241c32';ctx.lineWidth=8;ctx.beginPath();ctx.moveTo(-150,0);ctx.lineTo(130,0);ctx.lineTo(90,65);ctx.lineTo(-95,65);ctx.closePath();ctx.fill();ctx.stroke();ctx.fillStyle='#9a6832';ctx.fillRect(-45,-125,8,130);ctx.fillRect(45,-105,7,110);ctx.fillStyle='#e7e4d2';ctx.beginPath();ctx.moveTo(-40,-120);ctx.lineTo(35,-85);ctx.lineTo(-40,-55);ctx.fill();ctx.restore();
 // cave
 ctx.fillStyle='#152957';ctx.beginPath();ctx.moveTo(1390,worldH-125);ctx.lineTo(1410,worldH-390);ctx.lineTo(1510,worldH-510);ctx.lineTo(1640,worldH-480);ctx.lineTo(1740,worldH-330);ctx.lineTo(1790,worldH-125);ctx.fill();ctx.fillStyle='#020e31';ctx.beginPath();ctx.ellipse(1590,worldH-260,105,150,0,Math.PI,Math.PI*2);ctx.fill();for(let i=0;i<14;i++){ctx.fillStyle='#a94cff';ctx.fillRect(1450+i*20,worldH-350+Math.sin(i)*25,7,rand(15,40));}
 // sunken city
 for(let i=0;i<8;i++){let x=2050+i*60,y=worldH-260-(i%3)*35;ctx.fillStyle='#b89a5c';ctx.fillRect(x,y,38,135);ctx.fillStyle='#e8d08b';ctx.fillRect(x+7,y-30,24,30);ctx.fillStyle='#5bd7e9';ctx.fillRect(x+10,y+25,8,18);ctx.fillRect(x+24,y+25,8,18);}
 // kelp
 kelp.forEach(k=>{ctx.strokeStyle=k.c;ctx.lineWidth=5;ctx.lineCap='round';ctx.beginPath();ctx.moveTo(k.x,k.y);ctx.quadraticCurveTo(k.x+Math.sin(time*1.7+k.phase)*22,k.y-k.h*.55,k.x+Math.sin(time*1.7+k.phase+1)*28,k.y-k.h);ctx.stroke();});
 // corals
 for(let i=0;i<38;i++)drawCoral(i*71+25,worldH-125,rand(.7,1.35));
 // bubbles
 bubbles.forEach(b=>{b.y-=b.s;if(b.y<0)b.y=worldH;let bx=b.x+Math.sin(time*1.5+b.w)*8;ctx.strokeStyle='rgba(196,249,255,.8)';ctx.lineWidth=1.5;ctx.beginPath();ctx.arc(bx,b.y,b.r,0,Math.PI*2);ctx.stroke();ctx.fillStyle='rgba(255,255,255,.35)';ctx.fillRect(bx-b.r/2,b.y-b.r/2,2,2);});
 // fish schools
 fish.forEach(f=>{f.x+=f.dir*f.s*.55;if(f.x<0||f.x>worldW)f.dir*=-1;drawFish(f.x,f.y,f.s,f.dir,f.c,f.phase);});
 // jellyfish
 for(let i=0;i<5;i++){let x=420+i*440+Math.sin(time+i)*18,y=240+Math.sin(time*1.3+i)*25;ctx.fillStyle='#d98affaa';ctx.beginPath();ctx.arc(x,y,17,Math.PI,0);ctx.lineTo(x+17,y+5);ctx.quadraticCurveTo(x,y+18,x-17,y+5);ctx.fill();ctx.strokeStyle='#e6b6ff';for(let j=-2;j<=2;j++){ctx.beginPath();ctx.moveTo(x+j*6,y+7);ctx.lineTo(x+j*8+Math.sin(time*3+j)*4,y+28);ctx.stroke();}}
 // treasures
 treasures.forEach(t=>{if(t.got)return;let bob=Math.sin(time*3+t.phase)*4;rounded(t.x-10,t.y-9+bob,20,17,3,'#e69b23','#5a2d15');ctx.fillStyle='#ffe66b';ctx.fillRect(t.x-2,t.y-8+bob,4,15);});
 // player
 drawFish(player.x,player.y,1.55,player.dir,'#ff9f22',1);
 ctx.restore();
 // vignette
 const v=ctx.createRadialGradient(W/2,H/2,Math.min(W,H)*.2,W/2,H/2,Math.max(W,H)*.75);v.addColorStop(0,'transparent');v.addColorStop(1,'rgba(0,15,48,.38)');ctx.fillStyle=v;ctx.fillRect(0,0,W,H);
}
function showMessage(msg){const el=$('message');el.textContent=msg;el.style.display='block';toastTimer=2.2;}
function update(dt){
 time+=dt;if(player.inv>0)player.inv-=dt;
 let dx=(keys.ArrowRight||keys.d||touch.right?1:0)-(keys.ArrowLeft||keys.a||touch.left?1:0);
 let dy=(keys.ArrowDown||keys.s||touch.down?1:0)-(keys.ArrowUp||keys.w||touch.up?1:0);
 let boosting=(keys[' ']||touch.boost)&&player.boost<=0;
 if(boosting)player.boost=.45;if(player.boost>0)player.boost-=dt;
 const speed=player.boost>0?340:205;let mag=Math.hypot(dx,dy)||1;
 player.vx+=(dx/mag*speed-player.vx)*Math.min(1,dt*7);player.vy+=(dy/mag*speed-player.vy)*Math.min(1,dt*7);
 if(!dx)player.vx*=Math.pow(.06,dt);if(!dy)player.vy*=Math.pow(.06,dt);
 player.x=Math.max(25,Math.min(worldW-25,player.x+player.vx*dt));player.y=Math.max(120,Math.min(worldH-145,player.y+player.vy*dt));
 if(dx)player.dir=dx>0?1:-1;
 treasures.forEach(t=>{if(!t.got&&Math.hypot(t.x-player.x,t.y-player.y)<35){t.got=true;coins++;score+=50;localStorage.setItem('fw_coins',coins);localStorage.setItem('fw_score',score);$('coins').textContent=coins;$('score').textContent=String(score).padStart(6,'0');showMessage('✨ Tesouro encontrado! +50 pontos');}});
 camera.x=Math.max(0,Math.min(worldW-W,player.x-W/2));camera.y=Math.max(0,Math.min(worldH-H,player.y-H/2));
 if(toastTimer>0){toastTimer-=dt;if(toastTimer<=0)$('message').style.display='none';}
}
let last=performance.now();
function loop(now){let dt=Math.min(.033,(now-last)/1000);last=now;if(!paused)update(dt);drawScene();requestAnimationFrame(loop);}
requestAnimationFrame(loop);
addEventListener('keydown',e=>{keys[e.key]=true;if(['ArrowUp','ArrowDown','ArrowLeft','ArrowRight',' '].includes(e.key))e.preventDefault();if(e.key==='Escape')togglePause();});
addEventListener('keyup',e=>keys[e.key]=false);
document.querySelectorAll('[data-dir]').forEach(btn=>{let d=btn.dataset.dir;btn.addEventListener('pointerdown',e=>{e.preventDefault();touch[d]=true;btn.setPointerCapture(e.pointerId);});['pointerup','pointercancel','lostpointercapture'].forEach(ev=>btn.addEventListener(ev,()=>touch[d]=false));});
$('boost').addEventListener('pointerdown',e=>{e.preventDefault();touch.boost=true;});['pointerup','pointercancel','pointerleave'].forEach(ev=>$('boost').addEventListener(ev,()=>touch.boost=false));
$('interact').addEventListener('click',()=>showMessage('🐟 Continue explorando para encontrar tesouros!'));
function togglePause(){paused=!paused;$('pause').textContent=paused?'▶':'Ⅱ';showMessage(paused?'Jogo pausado':'Vamos nadar!');}
$('pause').addEventListener('click',togglePause);
$('score').textContent=String(score).padStart(6,'0');$('coins').textContent=coins;
try{import('../../auth.js').then(m=>{if(m.supabase){console.info('FISH WORLD: sessão da plataforma disponível.');}}).catch(()=>{});}catch(e){}
})();
</script>
</body>
</html>